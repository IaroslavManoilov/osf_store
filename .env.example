NUXT_ADMIN_KEY=change_this_to_a_long_secure_key

# Supabase backend (required)
NUXT_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Checkout notifications
NUXT_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NUXT_TELEGRAM_BOT_USERNAME=your_bot_username_without_@
NUXT_TELEGRAM_CHAT_ID=your_telegram_chat_id
NUXT_RESEND_API_KEY=your_resend_api_key
NUXT_ORDER_EMAIL_TO=orders@yourdomain.com
NUXT_ORDER_EMAIL_FROM=ONE STYLE FOREVER <orders@yourdomain.com>
NUXT_ORDER_TRACK_SECRET=change_this_to_another_long_secure_key
NUXT_ORDER_OTP_SECRET=change_this_to_yet_another_long_secure_key
# Optional: if not set, OTP falls back to NUXT_TELEGRAM_CHAT_ID
NUXT_ORDER_OTP_TELEGRAM_CHAT_ID=your_telegram_chat_id_for_customer_codes

# Optional: protect cleanup endpoint /api/system/cleanup
NUXT_CLEANUP_SECRET=change_this_to_cleanup_secret

# Stripe payments (for card checkout)
NUXT_STRIPE_SECRET_KEY=sk_live_or_test_key
NUXT_STRIPE_WEBHOOK_SECRET=whsec_from_stripe_webhooks
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
